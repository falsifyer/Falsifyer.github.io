# direnv: a project-local Python for the site scripts.
#
# The site needs no third-party packages; the gate imports cti_method from the
# suite checkout in _suite/, which is where scripts/README.md says to put it.
watch_file scripts
if [ ! -d .venv ]; then
  python3 -m venv .venv
fi
source .venv/bin/activate

if [ -d _suite/packages/cti-method/src ]; then
  export PYTHONPATH="$PWD/_suite/packages/cti-method/src${PYTHONPATH:+:$PYTHONPATH}"
fi
